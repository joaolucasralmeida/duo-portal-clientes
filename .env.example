# Modelo. Copie este arquivo como ".env" e preencha com os valores reais.
# O ".env" fica só nesta máquina — o .gitignore impede que ele vá pro GitHub.
#
# Onde achar os dois valores:
#   painel do Supabase > Project Settings > API
#
#   VITE_SUPABASE_URL      = o campo "Project URL"
#   VITE_SUPABASE_ANON_KEY = a chave "anon public"
#
# ATENÇÃO: existe outra chave nessa mesma tela, chamada "service_role".
# Ela NÃO entra aqui e não deve ser enviada para ninguém, nem por mensagem.
# Ela ignora todas as regras de segurança do banco.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
