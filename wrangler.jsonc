{
  // Configuracao de publicacao na Cloudflare.
  // Sem este arquivo, o `wrangler deploy` tenta adivinhar como publicar um
  // projeto Vite e exige Vite 6+. Dizendo explicitamente que a pasta `dist`
  // e um site estatico, ele publica sem precisar adivinhar nada.
  // Tem que bater com o nome do projeto no painel da Cloudflare. Se divergir,
  // a publicacao vai para o Worker errado ou falha.
  "name": "portal",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist",
    // O portal e uma pagina so: qualquer endereco desconhecido devolve o
    // index.html em vez de um erro 404.
    "not_found_handling": "single-page-application"
  }
}
